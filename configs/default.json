    "analytic_latency_tracks_wallclock": {
      "claim": "解析延迟与实测求值时间的排序同向（秩相关 ≥ 0.5）",
      "expect": true
    },
    "exact_equality_accepts_all_legal_rewrites": {
      "claim": "τ=0 时全部合法重写都能通过（即所有合法重写都逐位等价）",
      "expect": false
